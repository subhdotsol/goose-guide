// geolib/helpers.goose — imported by geolib.goose with `import .helpers;`
// (leading dot = path relative to the importing FILE, not the package root).
//
// An import just includes this file ONCE (even if imported from several
// places) and creates NO namespace. The namespace comes from the line below;
// several files may share a namespace.
import std;
namespace geolib;

fn twice(n: i64) -> i64 { n * 2 }
